{{- $pages := where site.RegularPages "Draft" false -}}
{{- $pages = where $pages "Params.private" "!=" true -}}
[
  {{- range $index, $page := $pages.ByLastmod.Reverse -}}
    {{- if $index }},{{ end }}
    {{- $summary := $page.Description | default $page.Summary | plainify -}}
    {{- $content := $page.Plain | htmlUnescape | plainify -}}
    {{- $sectionTitle := $page.Section -}}
    {{- with $page.CurrentSection -}}
      {{- $sectionTitle = .Title -}}
    {{- end -}}
    {{- dict
      "title" $page.Title
      "summary" $summary
      "content" $content
      "permalink" $page.RelPermalink
      "section" $page.Section
      "sectionTitle" $sectionTitle
      "categories" ($page.Params.categories | default slice)
      "tags" ($page.Params.tags | default slice)
      "date" ($page.Lastmod.Format "2006-01-02")
      "lastmod" ($page.Lastmod.Format "2006-01-02T15:04:05Z07:00")
    | jsonify -}}
  {{- end -}}
]
